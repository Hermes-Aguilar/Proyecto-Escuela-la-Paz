# Dependencias
/node_modules
/.pnp
.pnp.js

# Build de Next.js
/.next/
/out/
/build

# Variables de entorno (NUNCA subir secretos)
.env
.env.local
.env*.local
.env.development.local
.env.production.local

# Despliegue
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# Config local de Claude Code (no pertenece al repo)
.claude/
